# Requested: it should center the 3D view which is a fundamental function in 3D view
# Change: Use the built-in 3D view Center view function (threeDView.resetFocalPoint) instead of manual camera math.
# Use the built-in 3D view Center view function (threeDView.resetFocalPoint)
# instead of manual camera math (same action as the Center button in the 3D view toolbar).
import math

layoutManager = slicer.app.layoutManager()
if layoutManager.threeDViewCount() == 0:
    raise RuntimeError("STATE_NOT_APPLIED: 3D view centered on scene (no 3D view available)")

# The Center view button calls resetFocalPoint on the 3D view widget, which
# moves the camera focal point to the center of the visible scene content.
for viewIndex in range(layoutManager.threeDViewCount()):
    threeDView = layoutManager.threeDWidget(viewIndex).threeDView()
    threeDView.resetFocalPoint()

# Deterministic verification: every 3D camera node now has a finite focal
# point (the scene content center set by resetFocalPoint).
for cameraNode in slicer.util.getNodesByClass("vtkMRMLCameraNode"):
    focalPoint = [0.0] * 3
    cameraNode.GetFocalPoint(focalPoint)
    if not all(math.isfinite(v) for v in focalPoint):
        raise RuntimeError("STATE_NOT_APPLIED: 3D view centered on scene")
